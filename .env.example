# SentinelNet Environment Configuration Example

# Application Context
APP_ENV=development
APP_NAME=SentinelNet
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173

# Database Connection
# PostgreSQL: postgresql+asyncpg://sentinel_user:sentinel_password@localhost:5432/sentinel_db
# SQLite (Development Default): sqlite+aiosqlite:///./sentinel.db
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# Security & Authentication
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# Both values are required to create the first administrator.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# MQTT Broker Configuration (Future Ingestion)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Redis Cache / PubSub (Optional)
REDIS_URL=redis://localhost:6379/0
