APP_ENV=development
APP_NAME=SentinelNet Backend
API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
DEVICE_INGESTION_SECRET=replace-with-a-separate-random-secret-at-least-32-characters

# Both values are required to create the first administrator.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
